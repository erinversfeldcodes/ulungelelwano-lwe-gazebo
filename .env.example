# Local Postgres (matches docker-compose.yml). In CI/previews this points at
# a Neon branch instead.
DATABASE_URL=postgres://app:app@localhost:55432/app

# Used to build the link in magic-link sign-in emails.
# APP_BASE_URL=http://localhost:3000

# Magic-link email delivery (see crates/web/src/email.rs). Unset means
# sign-in links are logged to stdout instead of actually emailed — the
# default for local dev and CI, so neither needs a real Resend account.
# RESEND_API_KEY=
# EMAIL_FROM=onboarding@resend.dev

# GET /internal/email-check — hit by CI right after every deploy (prod and
# PR previews) to prove Resend actually works, failing the deploy if not.
# Not a liveness probe; not in fly.toml's health checks, since it sends a
# real email on every call. INTERNAL_CHECK_TOKEN gates it; unset means the
# endpoint always 401s. TEST_EMAIL_RECIPIENT is who the check email goes
# to; unset means the check is skipped (returns 200 without sending).
# INTERNAL_CHECK_TOKEN=
# TEST_EMAIL_RECIPIENT=

# Uploaded card images (see crates/web/src/storage.rs). Unset means the
# "image" field on the new/edit card form is silently skipped — the
# pasted-URL field still works either way. To use local Garage S3 (started
# by `just db-up`, bootstrapped once with `just storage-init`), uncomment
# all of these — the key/secret match the fixed dev key storage-init creates:
# S3_BUCKET=gazebo-cards
# S3_ENDPOINT=http://localhost:3900
# S3_ACCESS_KEY=gazebo-local-dev-key
# S3_SECRET_KEY=gazebo-local-dev-secret-access-key-0000000000000000
# Garage has no bucket-policy public reads, only host-routed website mode
# (see garage.toml's [s3_web]) — ".localhost" resolves to 127.0.0.1 with no
# /etc/hosts entry needed.
# S3_PUBLIC_URL=http://gazebo-cards.web.garage.localhost:3902
# S3_PATH_STYLE=true
# S3_REGION=garage

# Image search for image cards (see crates/web/src/image_search.rs) — lets
# the new/edit card form search Pexels + Pixabay + Openverse for a
# suitable image instead of only uploading a file. Openverse needs no key
# and is always queried; Pexels/Pixabay are simply skipped (fewer results,
# not an error) when their own key is unset. Get a free key at
# pexels.com/api and pixabay.com/api/docs.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
